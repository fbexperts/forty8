      </div>
    </div>
  </div>
</section>

{/* ===================================== WHAT YOU GET (02) ============= */}
<section class="border-b" style="border-color: var(--border);">
  <div class="mx-auto max-w-[1240px] px-5 md:px-8 section-py">
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-2">
        <div class="flex md:block items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em]" style="color: var(--fg-faint);">
          <span style="color: var(--fg-dim);">02</span>
          <span class="hidden md:block h-px w-10 mt-3 mb-3" style="background: var(--border-strong);"></span>
          <span>The free 10</span>
        </div>
      </div>
      <div class="col-span-12 md:col-span-10">
        <h2 class="font-display font-semibold tracking-[-0.03em] leading-[1.04] text-[32px] sm:text-[44px] md:text-[56px] max-w-[18ch]" style="color: var(--fg);">
          What's in the 10 free creatives.
        </h2>
        <p class="mt-4 text-[17px] md:text-[19px] max-w-[55ch]" style="color: var(--fg-dim);">
          Real ad creatives. Not template fills, not AI slop, not stock-photo collages.
