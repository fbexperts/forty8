        <ul class="mt-10 md:mt-14 grid grid-cols-1 md:grid-cols-2 gap-px rounded-2xl overflow-hidden border" style="background: var(--card-strong); border-color: var(--border);">
          {WHAT_YOU_GET.map((it, i) => (
            <li class="p-6 md:p-8 flex gap-4 md:gap-5" style="background: var(--bg-elev);">
              <span class="shrink-0 font-mono text-[11px] tracking-[0.12em] pt-1" style="color: var(--fg-faint);">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-display font-medium text-[17px] md:text-[19px] leading-snug tracking-[-0.01em]" style="color: var(--fg);">{it.title}</h3>
                <p class="mt-2 text-[14.5px] md:text-[15px] leading-[1.55]" style="color: var(--fg-dim);">{it.body}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-8 md:mt-10 inline-flex items-start gap-3 md:gap-4 rounded-2xl border px-5 md:px-6 py-4 md:py-5"
             style="border-color: color-mix(in oklch, var(--accent) 35%, transparent); background: color-mix(in oklch, var(--accent) 7%, transparent);">
          <span class="font-mono text-[11px] uppercase tracking-[0.14em] mt-1 shrink-0" style="color: var(--accent);">FYI</span>
          <p class="text-[15px] md:text-base leading-snug max-w-[70ch]" style="color: var(--fg);">
            <span class="font-semibold" style="color: var(--accent);">Free means free.</span>
            No card. No surprise charge on day 4. No upgrade timer counting down on your dashboard.
          </p>
        </div>

        <div class="mt-8 md:mt-10">
          <a href="#claim" class="flex w-full justify-center sm:inline-flex sm:w-auto items-center gap-2 rounded-full font-display font-medium text-[14px] md:text-[15px] px-5 md:px-6 py-3.5 sm:py-3 transition-transform hover:-translate-y-[1px] active:translate-y-0"
             style="background: var(--accent); color: var(--on-accent); box-shadow: 0 8px 24px -10px var(--accent);">
            Send me the free 10
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
              <path d="M1 5.5h9M6 1l4.5 4.5L6 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
            </svg>
          </a>
        </div>
