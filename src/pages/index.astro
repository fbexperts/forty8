---
import '../styles/global.css';
import { gallery } from '../data/gallery';

// ---- Data (locked copy from BRIEF.md, mirrored from design/redesign.jsx) ----

const WHAT_YOU_GET = [
  { title: '10 fully-rendered ad creatives', body: '4:5 portrait — the only static format Meta is actually rewarding in 2026.' },
  { title: 'Built around YOUR product',      body: 'YOUR audience, YOUR positioning. You give us a store URL and 3 short answers. We do the rest.' },
  { title: 'Hook + topic + mechanic + CTA on every frame', body: 'The senior-buyer checklist. Not "make it pop."' },
  { title: 'A real range of angles',         body: "No cosmetic variations dressed up as 10 ads. Andromeda will cluster those. We don't ship them." },
  { title: 'Ready to upload to Ads Manager', body: 'Delivered as PNGs, named, organized.' },
  { title: '48 hours, guaranteed',           body: 'Most orders ship in under 24. Refund if we miss.' },
];

const COMPARE = [
  { row: 'Output speed',         ai: 'Minutes',              agency: '1–4 weeks',              forty8: '48 hours' },
  { row: 'Quality control',      ai: 'Templating engine',    agency: "Varies by who's on shift", forty8: 'Senior-buyer reviewed' },
  { row: 'Physical-product DTC', ai: 'Documented blind spot', agency: 'Often fine',             forty8: 'Native' },
  { row: 'Entry cost',           ai: '$189–$399/mo',         agency: '$1K–$10K+/mo + setup',   forty8: '$0, no card' },
  { row: 'Risk',                 ai: 'Trial-to-charge traps', agency: '3-month contracts',     forty8: 'Refund if we miss 48h' },
  { row: 'Cadence',              ai: 'On-demand, single seat', agency: 'Once/month, slow rounds', forty8: 'Weekly retainer option' },
];

const VOICE_QUOTES = [
  { src: 'r/FacebookAds · u/SeniorHeat221', q: 'My winning ads used to last a month. Now they fatigue in a few days. Impossible to keep up without a massive design budget.' },
  { src: 'Nest Commerce · agency blog',     q: "You can't out-target the algorithm. You can out-supply it." },
  { src: 'AdCreative.ai review · Sean C.',  q: 'The product is like using templates from the 1990s. Really really bad.' },
];

const DASHBOARD_ROWS = [
  { tag: 'Premium haircare', spend: '$24.6M', roas: '5.14×' },
  { tag: 'Apparel DTC',      spend: '$18.2M', roas: '4.51×' },
  { tag: 'Outdoor gear',     spend: '$15.9M', roas: '7.96×' },
  { tag: 'Electronics DTC',  spend: '$12.4M', roas: '3.27×' },
  { tag: 'Beauty DTC',       spend: '$11.0M', roas: '2.75×' },
  { tag: 'Social casino',    spend: '$18.7M', roas: '—'     },
];

const EMAIL_THUMBS = [
  'scalp-serum', 'sleep-drink', 'phone-charger', 'kitchen-knife', 'hiking-boots',
  'headphones',  'coffee-beans', 'oral-care',    'baby-food',     'sneakers',
];

const FAQS = [
  { q: "What's the catch with $0?",
    a: "No catch. You enter your details, we ship 10 creatives in 48 hours. After delivery you'll see optional upgrades. You're never charged unless you choose one." },
  { q: 'Is this AI-generated slop dressed up as a real service?',
    a: "AI is used the same way an agency uses Photoshop — as a tool, not the deliverable. A senior Meta buyer reviews every creative before it ships. If it's not work I'd run on my own accounts, it doesn't ship." },
  { q: 'My niche is supplements / apparel / skincare / pet / other physical product. Does this work?',
    a: "Yes — physical products are the home turf. Most AI creative tools choke on physical goods (they're trained on digital products). forty8 is built for DTC ecom specifically." },
  { q: 'What format do I get?',
    a: 'Static creatives delivered as 4:5 portrait PNGs — the only static format Meta gets full reach on in 2026. Ready-to-publish videos (9:16 vertical MP4s for Reels & Stories, 15–30 seconds) are an optional add-on after delivery.' },
  { q: 'How is this different from Fiverr?',
    a: "Fiverr is fine for one-off angle tests at $50/video. forty8 is the production layer for the 10–50/week cadence Meta now requires. Different problem." },
  { q: "I'm already with an agency. Why try this?",
    a: "Most agencies ship 4–8 creatives per month. The math doesn't work in 2026. Run forty8 in parallel with your agency for a month — see whose 10 creatives convert better. The free tier exists for exactly this comparison." },
  { q: 'What happens to my store data and product info?',
    a: 'Used only to produce your creatives. Not sold, not shared with anyone, not used to train external AI models. Standard NDA available on request before delivery.' },
  { q: 'What if you miss the 48-hour delivery?',
    a: "Full refund. No questions. The 48 hours is the contract — that's why we put it in the brand name." },
  { q: 'Is this just for big brands?',
    a: 'No. The free tier exists so brands of any size can test the work. Most paying customers are running $50K–$500K/mo on Meta, but the free 10 are useful at any spend.' },
];

// SparkChart SVG path computation
const W = 320, H = 90;
const CPA_PTS = [62, 58, 55, 51, 47, 44, 40, 36, 33, 30, 28, 28];
const ROAS_PTS = [22, 28, 30, 36, 42, 48, 55, 62, 68, 74, 80, 84];
const toPath = (arr: number[]) => arr.map((v, i) => {
  const x = (i / (arr.length - 1)) * W;
  const y = H - (v / 100) * H;
  return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const roasPath = toPath(ROAS_PTS);
const cpaPath  = toPath(CPA_PTS);

// Hero marquee: duplicate sample list to make the loop seamless
const heroSamples = [...gallery, ...gallery];
const heroSamplesRev = [...heroSamples].reverse();
---
<!doctype html>
<html lang="en" data-theme="operator">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>forty8 — 10 ad creatives in 48 hours. Free.</title>
  <meta name="description" content="10 ad creatives built for your DTC store. In 48 hours. Free. Senior-buyer judgment at AI-tool volume — no templating engines, no agencies, no card." />
  <meta property="og:title" content="forty8 — 10 ad creatives in 48 hours. Free." />
  <meta property="og:description" content="Senior-buyer judgment at AI-tool volume for DTC ecom founders. No card to start." />
  <meta name="theme-color" content="#06080a" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

{/* ====================================================== NAV ======= */}
<header id="top" class="sticky top-0 z-30 backdrop-blur border-b" style="background: var(--bg-scrim); border-color: var(--border);">
  <div class="mx-auto max-w-[1240px] px-5 md:px-8 h-14 md:h-16 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="#top" class="flex items-baseline gap-px text-[19px] font-display font-semibold tracking-[-0.02em] leading-none">
        <span style="color: var(--fg);">forty</span><span style="color: var(--accent);">8</span>
      </a>
      <span class="hidden md:inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em]" style="color: var(--fg-faint);">
        <span class="inline-block size-1.5 rounded-full" style="background: var(--accent);"></span>
        <span>Ad-creatives service · 48h SLA</span>
      </span>
    </div>
    <div class="flex items-center gap-3 md:gap-5">
      <a href="#claim" class="hidden sm:inline text-[13px] font-medium transition-colors" style="color: var(--fg-dim);" onmouseover="this.style.color='var(--fg)'" onmouseout="this.style.color='var(--fg-dim)'">
        How it works
      </a>
      <a href="#claim" class="inline-flex items-center gap-2 rounded-full font-display font-medium text-[13px] md:text-sm px-3.5 md:px-4 py-1.5 md:py-2 transition-transform active:scale-[0.98]" style="background: var(--accent); color: var(--on-accent);">
        Get 10 creatives
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
          <path d="M1 5.5h9M6 1l4.5 4.5L6 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
        </svg>
      </a>
    </div>
  </div>
</header>

{/* ====================================================== HERO ====== */}
<section class="relative overflow-hidden border-b" style="border-color: var(--border);">
  <div class="pointer-events-none absolute inset-0 opacity-[0.22]" style="background: radial-gradient(60% 50% at 18% 0%, var(--accent) 0%, transparent 60%);"></div>

  <div class="relative mx-auto max-w-[1240px] px-5 md:px-8 pt-10 md:pt-16 pb-14 md:pb-24">
    <div class="flex items-center gap-3 font-mono text-[11px] md:text-[12px] uppercase tracking-[0.14em]" style="color: var(--fg-dim);">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1" style="border-color: var(--border-strong); background: var(--card-elev);">
        <span class="inline-block size-1.5 rounded-full animate-pulse" style="background: var(--positive);"></span>
        <span>Accepting orders · 48h SLA</span>
      </span>
      <span class="hidden sm:inline" style="color: var(--fg-faint);">For DTC founders running $50K–$500K/mo on Meta</span>
    </div>

    <div class="mt-7 md:mt-10 grid grid-cols-12 gap-6 md:gap-10 items-start">
      <div class="col-span-12 lg:col-span-7">
        <h1 class="font-display font-semibold tracking-[-0.035em] leading-[0.95] text-[36px] sm:text-[56px] md:text-[80px] lg:text-[92px]" style="color: var(--fg);">
          <span class="block">10 ad creatives,</span>
          <span class="block">built for your store.</span>
          <span class="block mt-1">
            In <span style="color: var(--accent);">48 hours</span>.
            <span class="font-light italic" style="color: var(--fg-faint);">Free.</span>
          </span>
        </h1>

        <p class="mt-7 md:mt-9 max-w-[44ch] text-[17px] md:text-[19px] leading-[1.5] text-pretty" style="color: var(--fg-mute);">
          Senior-buyer judgment at AI-tool volume. No templating engines. No agencies. No card to start.
        </p>

        <div class="mt-7 md:mt-10 flex flex-wrap items-center gap-4 md:gap-6">
          <a href="#claim" class="inline-flex items-center gap-2.5 rounded-full font-display font-medium text-[15px] md:text-base px-6 py-3.5 md:py-4 transition-transform hover:-translate-y-[1px] active:translate-y-0"
             style="background: var(--accent); color: var(--on-accent); box-shadow: 0 8px 30px -8px var(--accent);">
            Get my 10 creatives
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
              <path d="M1 5.5h9M6 1l4.5 4.5L6 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
            </svg>
          </a>
          <div class="font-mono text-[12px] leading-snug max-w-[16rem]" style="color: var(--fg-faint);">
            <div>Most orders ship in &lt; 24h.</div>
            <div>Full refund if we miss 48.</div>
          </div>
        </div>

        <div class="mt-10 md:mt-14 grid grid-cols-3 gap-3 md:gap-6 border-t pt-6 md:pt-8 max-w-[520px]" style="border-color: var(--border);">
          <div>
            <div class="font-display font-semibold text-[26px] md:text-[34px] tracking-[-0.02em] leading-none" style="color: var(--fg);">48h</div>
            <div class="mt-2 font-mono text-[10.5px] uppercase tracking-[0.12em]" style="color: var(--fg-faint);">Delivery SLA</div>
          </div>
          <div>
            <div class="font-display font-semibold text-[26px] md:text-[34px] tracking-[-0.02em] leading-none" style="color: var(--fg);">4:5</div>
            <div class="mt-2 font-mono text-[10.5px] uppercase tracking-[0.12em]" style="color: var(--fg-faint);">Portrait, native to Meta</div>
          </div>
          <div>
            <div class="font-display font-semibold text-[26px] md:text-[34px] tracking-[-0.02em] leading-none" style="color: var(--fg);">$0</div>
            <div class="mt-2 font-mono text-[10.5px] uppercase tracking-[0.12em]" style="color: var(--fg-faint);">No card to start</div>
          </div>
        </div>
      </div>

      {/* Hero marquee — 2 cols drifting opposite directions */}
      <div class="col-span-12 lg:col-span-5">
        <div class="relative h-[520px] md:h-[620px] overflow-hidden rounded-2xl ring-1" style="--tw-ring-color: var(--border); background: var(--card);">
          <div class="absolute inset-0 grid grid-cols-2 gap-3 p-3">
            <div class="marquee-col marquee-up">
              {heroSamples.map((s) => (
                <figure class="group relative overflow-hidden rounded-xl ring-1" style="background: var(--bg-elev); --tw-ring-color: var(--border);">
                  <img src={`/images/gallery/${s.slug}.jpg`} alt={s.hook} loading="lazy"
                       class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                  <div class="absolute inset-x-0 bottom-0 p-2 md:p-2.5" style="background: linear-gradient(to top, var(--scrim-strong), var(--scrim) 50%, transparent);">
                    <span class="font-mono text-[9.5px] md:text-[10px] uppercase tracking-[0.14em]" style="color: rgba(255,255,255,0.85);">{s.vertical}</span>
                  </div>
                </figure>
              ))}
            </div>
            <div class="marquee-col marquee-down">
              {heroSamplesRev.map((s) => (
                <figure class="group relative overflow-hidden rounded-xl ring-1" style="background: var(--bg-elev); --tw-ring-color: var(--border);">
                  <img src={`/images/gallery/${s.slug}.jpg`} alt={s.hook} loading="lazy"
                       class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                  <div class="absolute inset-x-0 bottom-0 p-2 md:p-2.5" style="background: linear-gradient(to top, var(--scrim-strong), var(--scrim) 50%, transparent);">
                    <span class="font-mono text-[9.5px] md:text-[10px] uppercase tracking-[0.14em]" style="color: rgba(255,255,255,0.85);">{s.vertical}</span>
                  </div>
                </figure>
              ))}
            </div>
          </div>
          <div class="pointer-events-none absolute inset-x-0 top-0 h-16" style="background: linear-gradient(to bottom, var(--bg), transparent);"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16" style="background: linear-gradient(to top, var(--bg), transparent);"></div>
          <div class="pointer-events-none absolute left-3 bottom-3 flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.14em] backdrop-blur-sm rounded-full px-2.5 py-1 ring-1"
               style="color: var(--fg-mute); background: var(--scrim); --tw-ring-color: var(--border-strong);">
            <span class="inline-block size-1.5 rounded-full" style="background: var(--accent);"></span>
            Real outputs · last 30 days
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ============================================== PAIN (01) ============ */}
<section class="border-b" style="border-color: var(--border); background: var(--bg);">
  <div class="mx-auto max-w-[1240px] px-5 md:px-8 section-py">
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-2">
        <div class="flex md:block items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em]" style="color: var(--fg-faint);">
          <span style="color: var(--fg-dim);">01</span>
          <span class="hidden md:block h-px w-10 mt-3 mb-3" style="background: var(--border-strong);"></span>
          <span>The math</span>
        </div>
      </div>
      <div class="col-span-12 md:col-span-10 max-w-[920px]">
        <h2 class="font-display font-semibold tracking-[-0.03em] leading-[1.02] text-[34px] sm:text-[48px] md:text-[60px]" style="color: var(--fg);">
          Meta's rent keeps going up.
          <span class="block" style="color: var(--fg-faint);">Your creative pipe can't keep up.</span>
        </h2>

        <div class="mt-9 md:mt-12 grid grid-cols-3 gap-2 md:gap-3">
          {[
            { big: '6d',    caption: 'Half-life of a winning ad in 2026 — down from 6 weeks.', red: false },
            { big: '60/mo', caption: 'Real variations needed at $50K+/mo, post-Andromeda.',    red: false },
            { big: '$5K',   caption: 'What an agency charges to ship 6 ads in a month.',       red: true  },
          ].map(({ big, caption, red }) => (
            <div class="rounded-2xl ring-1 p-5 md:p-6 relative overflow-hidden" style="background: var(--bg-elev); --tw-ring-color: var(--border);">
              <div class="absolute -right-4 -top-4 size-20 rounded-full opacity-[0.06]" style={`background: ${red ? 'var(--negative)' : 'var(--accent)'};`}></div>
              <div class="font-display font-semibold tracking-[-0.03em] leading-none text-[40px] sm:text-[52px] md:text-[68px]" style="color: var(--fg);">{big}</div>
              <div class="mt-3 md:mt-4 text-[12.5px] md:text-[13.5px] leading-snug max-w-[22ch]" style="color: var(--fg-dim);">{caption}</div>
            </div>
          ))}
        </div>

        <div class="mt-10 md:mt-14 grid grid-cols-12 gap-6 md:gap-10">
          <div class="col-span-12 md:col-span-7 space-y-5 text-[17px] md:text-[19px] leading-[1.55] text-pretty" style="color: var(--fg-mute);">
            <p>Your last winner died in <span class="font-mono text-[0.92em] px-1.5 py-[1px] rounded-md ring-1" style="background: var(--card-strong); color: var(--fg); --tw-ring-color: var(--border-strong);">6 days</span>, not 6 weeks. Background swaps and headline tweaks don't count anymore — Andromeda clusters them as one ad.</p>
            <p>The math shifted from <em class="not-italic" style="color: var(--fg);">"do I need 20 ads this month or 60?"</em> to <em class="not-italic" style="color: var(--fg);">"can I ship 50 real variations a week without burning a team or paying $5K to an agency that ships 6?"</em></p>
          </div>
          <aside class="col-span-12 md:col-span-5">
            <div class="rounded-2xl border p-5 md:p-6" style="border-color: var(--border-strong); background: var(--card);">
              <div class="font-mono text-[10.5px] uppercase tracking-[0.14em]" style="color: var(--fg-faint);">Source · Nest Commerce</div>
              <blockquote class="mt-3 font-display text-[20px] md:text-[24px] leading-[1.2] tracking-[-0.015em]" style="color: var(--fg);">
                "You can't out-target the algorithm.
                You can <span style="color: var(--accent);">out-supply</span> it."
              </blockquote>
            </div>
          </aside>
        </div>

        <div class="mt-12 md:mt-20 border-t pt-8 md:pt-12" style="border-color: var(--border);">
          <p class="font-display font-semibold tracking-[-0.04em] leading-[0.96] text-[36px] sm:text-[64px] md:text-[100px] lg:text-[120px] break-words" style="color: var(--fg);">
            forty<span style="color: var(--accent);">8</span><span style="color: var(--fg-faint);"> is the supply.</span>
          </p>
          <a href="#claim" class="mt-8 md:mt-10 inline-flex items-center gap-2 rounded-full font-display font-medium text-[14px] md:text-[15px] px-5 md:px-6 py-3 transition-transform hover:-translate-y-[1px] active:translate-y-0"
             style="background: var(--accent); color: var(--on-accent); box-shadow: 0 8px 24px -10px var(--accent);">
            Claim the free 10
