{/* ============================================ INLINE SCRIPTS ======== */}
<script is:inline define:vars={{ galleryData: gallery }}>
  // ---- Form submit: redirect to OTO funnel, no inline confirmation ----
  document.getElementById('claimForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    if (!form.checkValidity()) { form.reportValidity(); return; }
    // TODO: POST form data to backend BEFORE redirecting.
    window.location.href = '/oto1';
  });

  // ---- Gallery drawer ----
  const tiles    = document.querySelectorAll('.js-gallery-open');
  const backdrop = document.getElementById('gallery-backdrop');
  const drawer   = document.getElementById('gallery-drawer');
  const img      = document.getElementById('gallery-img');
  const imgBlur  = document.getElementById('gallery-img-blur');
  const idxEl    = document.getElementById('gallery-idx');
  const verticalEl = document.getElementById('gallery-vertical');
  const formatEl   = document.getElementById('gallery-format');
  const hookEl     = document.getElementById('gallery-hook');
  const painEl     = document.getElementById('gallery-pain');
  const moveEl     = document.getElementById('gallery-move');
  const convertEl  = document.getElementById('gallery-convert');
  const builtForEl = document.getElementById('gallery-builtfor');
  const badgeEl    = document.getElementById('gallery-badge');

  let cur = -1;

  function renderBadge(t) {
    if (t.badgeKind === 'result') {
      badgeEl.innerHTML = `
        <div class="inline-flex flex-col items-start gap-0.5 rounded-md px-2.5 py-2 max-w-full shadow-lg" style="background: var(--accent); color: var(--on-accent);">
          <span class="font-mono text-[9px] uppercase tracking-[0.16em] opacity-75 leading-none">Verified result</span>
          <span class="font-display font-semibold text-[12.5px] md:text-[13px] leading-[1.15] tracking-[-0.005em]">${t.badge}</span>
        </div>`;
    } else {
      badgeEl.innerHTML = `
        <div class="inline-flex items-center gap-1.5 rounded-md px-2 py-1.5 backdrop-blur-sm ring-1" style="background: var(--scrim-strong); --tw-ring-color: var(--border-strong);">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] italic" style="color: rgba(231,234,239,0.8);">${t.badge}</span>
        </div>`;
    }
  }

  function open(i) {
    cur = ((i % galleryData.length) + galleryData.length) % galleryData.length;
    const t = galleryData[cur];
    img.src = `/images/gallery/${t.slug}.jpg`;
    imgBlur.src = img.src;
    idxEl.textContent = String(cur + 1).padStart(2, '0');
    verticalEl.textContent = t.vertical;
    formatEl.textContent = t.format;
    hookEl.textContent = `“${t.hook}”`;
    painEl.textContent = t.pain;
    moveEl.textContent = t.whatWeDid;
    convertEl.textContent = t.whyItConverts;
    builtForEl.textContent = t.builtFor;
    renderBadge(t);
    backdrop.style.opacity = '1';
    backdrop.style.pointerEvents = 'auto';
    drawer.style.transform = 'translateX(0)';
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    backdrop.style.opacity = '0';
    backdrop.style.pointerEvents = 'none';
    drawer.style.transform = '';
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    cur = -1;
  }

  tiles.forEach((b, i) => b.addEventListener('click', () => open(i)));
  backdrop.addEventListener('click', close);
  document.getElementById('gallery-close').addEventListener('click', close);
  document.getElementById('gallery-prev').addEventListener('click', () => open(cur - 1));
  document.getElementById('gallery-next').addEventListener('click', () => open(cur + 1));
  document.getElementById('gallery-cta-close').addEventListener('click', close);
  window.addEventListener('keydown', (e) => {
    if (cur < 0) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowRight') open(cur + 1);
    if (e.key === 'ArrowLeft')  open(cur - 1);
  });
</script>

</body>
